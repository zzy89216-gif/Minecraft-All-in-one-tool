# ---------------------------------------------------------------------------
# GitHub upload configuration - copy this file to `.env` and fill in the token.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed.
# ---------------------------------------------------------------------------

# A Personal Access Token with `repo` scope (classic) or "Contents: Read and write"
# (fine-grained) for the target repository.
GITHUB_TOKEN=

# GitHub account that owns the repository.
GITHUB_USERNAME=zzy89216-gif

# Repository name (without the owner).
GITHUB_REPO=Minecraft-All-in-one-tool

# Branch that receives the push.
GITHUB_BRANCH=main
